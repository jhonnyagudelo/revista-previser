---
import MainLayout from "@/layouts/mainLayout/MainLayout.astro";
import Sites from "@/components/sites/Sites.astro";
import { AttendanceForm } from "@/components/attendanceForm";
import { fetchApi } from "@/utilities";
import type { Guest, Attendance } from "@/interfaces";
import { Image } from "astro:assets";
import imgLogo from "public/assets/imgs/Landig Invitación Late verde segmentada_logo.png";
import imgFondoHeader from "public/assets/imgs/Landig Invitación Late verde segmentada_Fondo 1.png";
import imgCamilaGiraldo from "public/assets/imgs/Landig Invitación Late verde segmentada_foto camila.png";
import hojaVerte from "public/assets/imgs/Landig Invitación Late verde segmentada_hojas f2.png";
import iconVacation from "public/assets/imgs/Landig Invitación Late verde segmentada_imagen 4 f4.png";
import iconEducation from "public/assets/imgs/Landig Invitación Late verde segmentada_imagen 3 f4.png";
import tradeIcon from "public/assets/imgs/Landig Invitación Late verde segmentada_imagen 2 f4.png";
import medicinaIcon from "public/assets/imgs/Landig Invitación Late verde segmentada_imagen 1 f4.png";
import petIcon from 'public/assets/imgs/Landig Invitación Late verde segmentada_imagen 5 f4.png'

const endpoint = "/event"; // Assuming this is a string

const response = await fetchApi(endpoint);

const { id } = Astro.params;

const endpointCustomer = `/customer/${id}`; // Assuming this is a string

// Consulta a la API para obtener los datos del invitado
let guest = null;
try {
  guest = (await fetchApi(endpointCustomer)) as Guest;

  if (guest?.status === 404) {
    return Astro.redirect("/404");
  }
} catch (error) {
  console.error("Error al obtener datos del invitado:", error);
  return Astro.redirect("/404");
}

if (!guest) {
  return Astro.redirect("/404");
}

const endpointAttendance = `/attendance/${id}`; // Assuming this is a string
let confirm = null;

try {
  confirm = (await fetchApi(endpointAttendance)) as Attendance;
} catch (error) {
  console.error("Error al obtener datos del invitado:", error);
}
let msgButton;

msgButton = confirm?.data?.confirm_attendance
  ? "Obtener Qr"
  : "¡Confirma aquí tu asistencia!";

---

<MainLayout title="Home">
  <section class="relative flex justify-center items-center flex-col">
    {/* Fondo: Ocupa todo el espacio, sigue siendo responsive */}
    <Image
      src={imgFondoHeader}
      alt="Fondo de la cabecera"
      class="w-full h-auto"
    />

    {/* Contenedor del Logo: ¡Aquí están los cambios! */}
    <article
      class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-[40%]
           backdrop-blur-md rounded-lg p-4
           max-w-[90%]
           md:max-w-[600px]
           w-auto flex justify-center items-center"
    >
      <Image
        class="w-full h-auto max-w-full object-contain"
        src={imgLogo}
        alt="Logo"
      />
    </article>
  </section>
  <section
    class="bg-green-mate w-full flex flex-col md:flex-row justify-around items-center gap-6 py-8 px-4"
  >
    <article class="grid md:grid-cols-2 gap-6 items-center relative w-[90vw]">
      <div class="relative order-2 md:order-none">
        <div
          class="relative flex items-center max-md:justify-center bg-white p-4 md:p-8 rounded-3xl text-center xl:w-[65em] md:w-[50em] xl:h-[30em] lg:h-[20em] md:h-[20em]"
        >
          <!-- Contenido (debajo) -->
          <div class="relative z-10 md:w-[50%] lg:w-[70%]">
            <p class="text-sm md:text-xl">Bajo el lema</p>

            <p
              class="bg-green font-bold text-primary-white-hueso px-1 rounded text-base md:text-xl inline-block"
            >
              "Previser ecodigital late verde"
            </p>

            <p class="text-sm md:text-xl">
              Un paso más hacia un futuro más sostenible y digital
            </p>

            <div class="my-4">
              <AttendanceForm
                server:defer
                document={guest?.data?.document}
                button={msgButton}
                client:only="react"
              />
            </div>

            <p class="text-xs md:text-2xl font-bold">
              Hasta el 16 de noviembre
            </p>
          </div>

          <!-- 🌿 Hojas encima -->
          <div class="absolute inset-0 flex items-center pointer-events-none">
            <Image
              class="object-contain z-30 opacity-90 w-[20em] max-sm:w-[14em] drop-shadow-lg"
              src={hojaVerte}
              alt="Hoja verde"
              width={500}
              height={500}
            />
          </div>
        </div>
      </div>

      <div class="order-1 md:order-none">
        <picture class="flex justify-center items-center">
          <Image
            class="w-full max-md:w-[30em] max-sm:w-[14em] h-auto max-w-full object-contain"
            src={imgCamilaGiraldo}
            alt="Camila Giraldo"
          />
        </picture>
      </div>
    </article>
  </section>
  <section class="bg-white flex justify-center items-center">
    <div class="w-[80%] flex flex-col justify-center rounded-b-3xl">
      <h1 class="text-3xl pt-4 text-white text-center m-0 bg-green">
        {guest?.data?.name?.toUpperCase()}
        {guest?.data?.surname?.toUpperCase()}
      </h1>
      {
        Array.isArray(response) ? (
          response.map((event) => <Sites event={event} />)
        ) : (
          <p>No events found</p>
        )
      }
    </div>
  </section>
  <section
    class="p-4 bg-gradient-to-b from-primary-blue to-secondary-blue mt-3"
  >
    <p class="text-white text-center text-lg md:text-xl font-semibold">
      Gracias por ser parte de esta gran red que late por el bienestar de las
      familias colombianas
    </p>
  </section>
  <section class=" bg-green-mate pb-3">
    <article class="grid grid-cols-5 max-sm:grid-cols-2">
    <Image class="p-5" src={medicinaIcon} alt="Medicina Icon" />
    <Image class="p-5" src={tradeIcon} alt="Trade Icon" />
    <Image class="p-5" src={iconEducation} alt="Education Icon" />
    <Image class="p-5" src={iconVacation} alt="Vacation Icon" />
    <Image class="p-5" src={petIcon} alt="pet Icon" />
    </article>
    <p class="text-xl font-bold text-black text-center w-2/3 mx-auto">Su compromiso impulsa nuestro propósito de conectar beneficios, sostenibilidad y experiencia reales para miles de personas en todo el país </p>
  </section>
</MainLayout>
