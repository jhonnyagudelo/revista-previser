---
import { AttendanceForm } from "@/components/attendanceForm";
import Sites from "@/components/sites/Sites.astro";
import { Image } from "astro:assets";
import imgCamilaGiraldo from "@public/assets/imgs/Landig Invitación Late verde segmentada_foto camila.png";
import hojaVerte from "@public/assets/imgs/Landig Invitación Late verde segmentada_hojas f2.png";
import { PublicRoutes } from "@/utilities";
const {guest, msgButton, response, confirm} = Astro.props;
---

<section
  class="bg-green-mate w-full flex flex-col md:flex-row justify-around items-center gap-6 py-8 px-4"
>
  <article class="grid md:grid-cols-2 gap-6 items-center relative w-[90vw]">
    <div class="relative order-2 md:order-none">
      <div
        class="relative flex items-center max-md:justify-center bg-white p-4 md:p-8 rounded-3xl text-center xl:w-[65em] md:w-[50em] xl:h-[30em] lg:h-[20em] md:h-[20em]"
      >
        <!-- Contenido (debajo) -->
        <div class="relative z-10 md:w-[50%] lg:w-[70%]">
          <p class="text-sm md:text-xl">Bajo el lema</p>

          <p
            class="bg-green font-bold text-primary-white-hueso px-1 rounded text-base md:text-xl inline-block"
          >
            "Previser ecodigital late verde"
          </p>

          <p class="text-sm md:text-xl">
            Un paso más hacia un futuro más sostenible y digital
          </p>

           {
            confirm ? (
              <div class="my-4">
                <a
                  href={`/${PublicRoutes?.PUBLIC}/${PublicRoutes?.CONFIRM}/${guest?.data?.document}`}
                  class="bg-green text-white font-bold py-2 px-4 rounded hover:bg-dark-green transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95"
                  target="_blank"
                  rel="noopener noreferrer"
                  onclick="this.style.transform = 'scale(0.95)'; setTimeout(() => this.style.transform = 'scale(1)', 150);"
                >
              {msgButton}
                </a>
              </div>
            ) : (
              <div class="my-4">
                <AttendanceForm
                  server:defer
                  document={guest?.data?.document}
                  button={msgButton}
                  client:only="react"
                />
              </div>
            )
          }
        </div>

        <!-- 🌿 Hojas encima -->
        <div class="absolute inset-0 flex items-center pointer-events-none">
          <Image
            class="object-contain z-30 opacity-90 w-[20em] max-sm:w-[14em] drop-shadow-lg"
            src={hojaVerte}
            alt="Hoja verde"
            width={500}
            height={500}
          />
        </div>
      </div>
    </div>

    <div class="order-1 md:order-none">
      <picture class="flex justify-center items-center">
        <Image
          class="w-full max-md:w-[30em] max-sm:w-[14em] h-auto max-w-full object-contain"
          src={imgCamilaGiraldo}
          alt="Camila Giraldo"
        />
      </picture>
    </div>
  </article>
</section>
<section class="bg-white flex justify-center items-center">
  <div class="w-[80%] flex flex-col justify-center rounded-b-3xl">
    <h1 class="text-3xl pt-4 text-white text-center m-0 bg-green">
      {guest?.data?.name?.toUpperCase()}
      {guest?.data?.surname?.toUpperCase()}
    </h1>
    {
      Array.isArray(response) ? (
        response.map((event) => <Sites event={event} />)
      ) : (
        <p>No events found</p>
      )
    }
  </div>
</section>
<section class="p-4 bg-gradient-to-b from-primary-blue to-secondary-blue mt-3">
  <p class="text-white text-center text-lg md:text-xl font-semibold">
    Gracias por ser parte de esta gran red que late por el bienestar de las
    familias colombianas
  </p>
</section>
