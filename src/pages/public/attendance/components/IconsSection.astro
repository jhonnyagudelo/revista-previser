---
import { Image } from "astro:assets";
import iconVacation from "public/assets/imgs/Landig Invitación Late verde segmentada_imagen 4 f4.png";
import iconEducation from "public/assets/imgs/Landig Invitación Late verde segmentada_imagen 3 f4.png";
import tradeIcon from "public/assets/imgs/Landig Invitación Late verde segmentada_imagen 2 f4.png";
import medicinaIcon from "public/assets/imgs/Landig Invitación Late verde segmentada_imagen 1 f4.png";
import petIcon from "public/assets/imgs/Landig Invitación Late verde segmentada_imagen 5 f4.png";
---
  <section class="bg-green-mate pb-3">
    <article class="grid grid-cols-5 max-sm:grid-cols-2">
      <Image class="p-5" src={medicinaIcon} alt="Medicina Icon" />
      <Image class="p-5" src={tradeIcon} alt="Trade Icon" />
      <Image class="p-5" src={iconEducation} alt="Education Icon" />
      <Image class="p-5" src={iconVacation} alt="Vacation Icon" />
      <Image class="p-5" src={petIcon} alt="pet Icon" />
    </article>
    <p class="text-xl font-bold text-black text-center w-2/3 mx-auto">
      Su compromiso impulsa nuestro propósito de conectar beneficios,
      sostenibilidad y experiencia reales para miles de personas en todo el país
    </p>
  </section>
