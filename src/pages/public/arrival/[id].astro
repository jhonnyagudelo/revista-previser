---
import { ArrivalForm } from "../../../components/arrivalForm";
import MainLayout from "../../../layouts/mainLayout/MainLayout.astro";
import { fetchApi } from "../../../utilities";
import type { Guest } from "../../../interfaces";

const imgUrl = "../../../assets/imgs/conectados_.png";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/404");
}

const endpointCustomer = `/customer/${id}`;

// Fetch guest data with better error handling
let guest: Guest | null = null;
let errorMessage = "";

try {
  guest = (await fetchApi(endpointCustomer)) as Guest;

  if (!guest?.data) {
    errorMessage = `No se encontraron datos para el invitado con ID: ${id}`;
  }
} catch (error) {
  console.error("Error al obtener datos del invitado:", error);
  errorMessage = "Error al cargar los datos del invitado. Intente nuevamente.";
}
---

<MainLayout title="Confirmar asistencia">
  <section
    class="relative min-h-screen flex flex-col items-center justify-center"
  >
    <img
      class="absolute inset-0 w-full h-full object-cover"
      src={imgUrl}
      alt="Imagen de bienvenida"
      loading="eager"
    />

    {
      errorMessage ? (
        <div class="z-10 text-center p-10 bg-red-500/80 rounded-lg">
          <p class="text-white text-xl">{errorMessage}</p>
        </div>
      ) : (
        <div class="z-10 text-center p-10 bg-black/30 rounded-lg backdrop-blur-sm">
          <h1 class="text-4xl sm:text-6xl p-3 text-white font-bold">
            Bienvenido:
          </h1>
          <h2 class="text-3xl sm:text-5xl p-3 text-white font-bold">
            {guest?.data?.name?.toUpperCase()}
            {guest?.data?.surname?.toUpperCase()}
          </h2>
          {guest?.data?.document && (
            <ArrivalForm document={guest.data.document} client:only="react" />
          )}
        </div>
      )
    }
  </section>
</MainLayout>

<style>
  @media (min-width: 768px) {
    .qr {
      transform: translate(10px, 10px);
    }
  }
</style>
